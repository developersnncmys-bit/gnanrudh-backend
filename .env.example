PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/house_of_gnanrudh
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
JWT_SECRET=replace-me-with-a-long-random-string
ADMIN_EMAIL=admin@houseofgnanrudh.com
ADMIN_PASSWORD=admin123

# Cloudinary (image CDN). Leave blank to fall back to local disk uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Razorpay (checkout). KEY_ID + KEY_SECRET are required for the happy-path
# payment flow (POST /api/customer-auth/payment/order and /payment/verify).
# Both live under Dashboard → Settings → API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: webhook secret, used only by POST /api/webhooks/razorpay. The
# webhook is a server-to-server safety net for the rare case where the
# browser dies after payment but before the success callback fires. Payments
# work fine without it — leave blank until you point a webhook at the
# backend from Dashboard → Settings → Webhooks.
RAZORPAY_WEBHOOK_SECRET=
